{
  "$schema": "https://agentskills.io/schema/skills.json",
  "name": "rfp-workflow-skill-pack",
  "version": "1.0.0",
  "description": "RFP workflow skills with optional export integrations.",
  "skills": [
    {
      "name": "rfp-workflow",
      "path": "skills/rfp-workflow/SKILL.md",
      "description": "Umbrella skill that routes to the orchestrator."
    },
    {
      "name": "rfp-agentic-orchestrator",
      "path": "skills/rfp-agentic-orchestrator/SKILL.md",
      "description": "Runs ingest, clarify, PRD, decomposition, stories, and export."
    },
    {
      "name": "rfp-ingest",
      "path": "skills/rfp-ingest/SKILL.md"
    },
    {
      "name": "rfp-clarify",
      "path": "skills/rfp-clarify/SKILL.md"
    },
    {
      "name": "rfp-prd-draft",
      "path": "skills/rfp-prd-draft/SKILL.md"
    },
    {
      "name": "rfp-prd-refine",
      "path": "skills/rfp-prd-refine/SKILL.md"
    },
    {
      "name": "rfp-decompose",
      "path": "skills/rfp-decompose/SKILL.md"
    },
    {
      "name": "rfp-stories",
      "path": "skills/rfp-stories/SKILL.md"
    },
    {
      "name": "rfp-export",
      "path": "skills/rfp-export/SKILL.md"
    }
  ],
  "bundles": [
    {
      "name": "rfp-core",
      "description": "Installs all RFP workflow skills with local markdown outputs.",
      "skills": [
        "rfp-workflow",
        "rfp-agentic-orchestrator",
        "rfp-ingest",
        "rfp-clarify",
        "rfp-prd-draft",
        "rfp-prd-refine",
        "rfp-decompose",
        "rfp-stories",
        "rfp-export"
      ]
    },
    {
      "name": "rfp-core-jira-google-docs",
      "description": "RFP skills plus third-party MCP servers for Jira and Google Docs export paths.",
      "skills": [
        "rfp-workflow",
        "rfp-agentic-orchestrator",
        "rfp-ingest",
        "rfp-clarify",
        "rfp-prd-draft",
        "rfp-prd-refine",
        "rfp-decompose",
        "rfp-stories",
        "rfp-export"
      ],
      "mcpServers": [
        {
          "name": "atlassian-mcp-server",
          "provider": "atlassian",
          "purpose": "Jira (and Confluence) issue/project export integration.",
          "source": "https://github.com/atlassian/atlassian-mcp-server",
          "required": true
        },
        {
          "name": "google-docs-mcp",
          "provider": "a-bonus",
          "purpose": "Google Docs content creation/editing integration.",
          "source": "https://github.com/a-bonus/google-docs-mcp",
          "required": true
        }
      ]
    }
  ]
}
